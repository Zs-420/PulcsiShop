@model PulcsiShop.Models.Order
@{
    ViewData["Title"] = "Order";
}
<h1>Sikeres rendelés!</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Home" asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrderId" />
            <div class="form-group">
                <label asp-for="CustomerName" class="control-label"></label>
                <input readonly asp-for="CustomerName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ZipCode" class="control-label"></label>
                <input readonly asp-for="ZipCode" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <input readonly asp-for="Address" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input readonly asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Note" class="control-label"></label>
                <input readonly asp-for="Note" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="TotalPrice" class="control-label"></label>
                <input readonly asp-for="TotalPrice" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


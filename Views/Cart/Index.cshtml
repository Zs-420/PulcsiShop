<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <h3 style="font-weight:bold">Kosár</h3>
    <table width="80%" cellpading="2" cellspacing="2" border="1">
        <tr>
            <th>Lehetőségek</th>
            <th>Termék neve</th>
            <th>Ára</th>
            <th>Darabszám</th>
            <th>Összeg</th>
        </tr>
        @foreach (var item in ViewBag.cart)
        {
            <tr width="80%">
                <td>
                    <a asp-controller="cart" asp-action="remove" asp-route-id="@item.Product.PulcsiID" style="color:red; text-decoration:none"> Eltávolítás a kosárból</a>
                </td> 
                <td>@item.Product.Name</td>
                <td>@item.Product.Price Ft</td>
                <td>@item.Quantity db</td>
                <td>@(item.Product.Price * item.Quantity) Ft</td>
            </tr>
        }
        <tr>
            <td align="right" colspan="6" style="font-weight:bold; font-size:20px" >Végösszeg: </td>
            <td align="center">@ViewBag.total Ft</td>
        </tr>
    </table>
    <br />
    <a asp-controller="home" asp-action="index" style="font-size:20px; text-decoration:none">Vásárlás folytatása</a>
    <br />
    @if (ViewBag.cart.Count != 0)
    {
        <a asp-controller="Cart" asp-action="CheckOut" style="font-size:20px; text-decoration:none">Fizetés</a>
    }
</body>
</html>

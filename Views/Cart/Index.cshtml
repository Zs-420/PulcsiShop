<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <h3>Kosár</h3>
    <table width="80%" cellpading="2" cellspacing="2" border="1">
        <tr>
            <th>Lehetőségek</th>
            <th>Sorszám</th>
            <th><center>Termék neve</center></th>
            <th>Ár</th>
            <th>Darabszám</th>
            <th>Összeg</th>
        </tr>
        @foreach (var item in ViewBag.cart)
        {
            <tr width="80%">
                <td>
                    <a asp-controller="cart" asp-action="remove" asp-route-id="@item.Product.PulcsiID"> Eltávolítás </a>
                </td>
                <td>@item.Product.PulcsiID</td>
                <td>@item.Product.Name</td>
                <td>@item.Product.Price</td>
                <td>@item.Quantity</td>
                <td>@(item.Product.Price * item.Quantity)</td>
            </tr>
        }
        <tr>
            <td align="right" colspan="6">Végösszeg: </td>
            <td>@ViewBag.total</td>
        </tr>
    </table>
    <br />
    <a asp-controller="home" asp-action="index">Vásárlás folytatása</a>
    <br />
    @* <a asp-controller="home" asp-action="index">CheckOut</a> *@  
    @if (ViewBag.cart.Count != 0)
    {
        <a asp-controller="Cart" asp-action="CheckOut">Fizetés</a>
    }
</body>
</html>

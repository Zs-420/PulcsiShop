@model PulcsiShop.Models.Order

<h2>Biztosan törölni szeretné ezt a rendelést?</h2>

<div>
    <h4>Rendelés</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Név</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3">Cím</dt>
        <dd class="col-sm-9">@Model.Address</dd>

        <dt class="col-sm-3">Összeg</dt>
        <dd class="col-sm-9">@Model.TotalPrice</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="OrderId" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-action="Index">Vissza a listához</a>
    </form>
</div>

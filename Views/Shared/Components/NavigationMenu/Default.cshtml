@model IEnumerable<string>

<link rel="stylesheet" href="~/css/site.css" />

<div style="display: flex; justify-content: center; align-items: center; width: 100%;">
    <input class="search-input" name="search" placeholder="Keresés..." type="search" id="searchBar">
</div>

<a class="@(String.IsNullOrEmpty(ViewBag.SelectedCategory)?"nav-btn-selected":"nav-btn")" asp-controller="Home" asp-action="Index"
 asp-route-category="">Minden méret</a>
@foreach (string category in Model)
{
    <a class="@(ViewBag.SelectedCategory==category?"nav-btn-selected":"nav-btn")" asp-controller="Home" asp-action="Index"
     asp-route-category="@category">@category</a>
}

<script>
    document.getElementById("searchBar").addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            const keyword = this.value;
            const url = new URL(window.location.href);
            url.searchParams.set("keyword", keyword);
            window.location.href = url.toString();
        }
    });
</script>

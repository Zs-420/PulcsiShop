@model IEnumerable<string>

<style>
    .nav-btn {
        min-width: 100%;
        height: 50px;
        color: black;
        background-color: rgb(224, 224, 224);
        cursor: pointer;
        text-align: center;
        align-items: center;
        text-decoration: none;
        line-height: 50px;
        border: 1px solid;
        border-color: rgba(26,26,26, 0.4);
    }

        .nav-btn:hover,
        .nav-btn:active{
            background-color: rgb(209, 209, 209);
            color: black;
        }

    .nav-btn-selected {
        min-width: 100%;
        height: 50px;
        color: white;
        background-color: rgb(255, 65, 51);
        cursor: pointer;
        text-align: center;
        align-items: center;
        text-decoration: none;
        line-height: 50px;
        border: 1px solid;
        border-color: rgba(26,26,26, 0.4);
    }

        .nav-btn-selected:hover,
        .nav-btn-selected:active {
            background-color: rgb(255, 74, 61);
            color: white;
        }

    .search-input {
        width: 90%;
        background-color: white;
        padding-left: 10px;
        padding-right: 10px;
        color: #242424;
        margin-bottom: 25px;
        min-height: 40px;
        border-radius: 4px;
        outline: none;
        border: none;
        line-height: 1.15;
    }

        .search-input:focus {
            border-bottom: 2px solid rgb(255, 65, 51);
            border-radius: 4px 4px 2px 2px;
        }

        .search-input:hover {
            outline: 1px solid rgb(26,26,26);
        }

</style>

<div style="display: flex; justify-content: center; align-items: center; width: 100%;">
    <input class="search-input" name="search" placeholder="Itt keress..." type="search" id="searchBar">
</div>

<a class="@(String.IsNullOrEmpty(ViewBag.SelectedCategory)?"nav-btn-selected":"nav-btn")" asp-controller="Home" asp-action="Index"
 asp-route-category="">All sizes</a>
@foreach (string category in Model)
{
    <a class="@(ViewBag.SelectedCategory==category?"nav-btn-selected":"nav-btn")" asp-controller="Home" asp-action="Index"
     asp-route-category="@category">@category</a>
}

<script>
    document.getElementById("searchBar").addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            const keyword = this.value;
            const url = new URL(window.location.href);
            url.searchParams.set("keyword", keyword);
            window.location.href = url.toString();
        }
    });
</script>

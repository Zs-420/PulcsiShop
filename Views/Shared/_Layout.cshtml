<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>PulcsiShop</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="layout">
        <header>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <img src="~/images/pulcsi.png" alt="Pulcsi logo" style="max-height: var(--header-height);" />
                <div style="font-size: 32px; font-weight: bold;">PULCSI SHOP</div>
            </div>
            <partial name="_LoginPartial" />
        </header>

        <main>
            <div id="categories" style="display: flex; flex-direction: column; justify-content: center; height: calc(100vh - var(--footer-height) - var(--header-height));">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div class="content">
                @RenderBody()
                @RenderSection("scripts", required: false)
            </div>
        </main>

        <footer>
            &copy; 2025 - PulcsiShop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>PulcsiShop</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <style>
        :root {
            --header-height: 62px;
            --footer-height: 25px;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
        }

        .layout {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            background: white;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        main {
            display: flex;
            flex: 1;
            margin-top: var(--header-height);
            margin-bottom: var(--footer-height);
            overflow: hidden;
        }

        #categories {
            width: 25%;
            max-width: 250px;
            background: #f5f5f5;
            overflow-y: auto;
        }

        .content {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: var(--footer-height);
            background: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>

    <div class="layout">
        <header>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <img src="~/images/pulcsi.png" alt="Pulcsi logo" style="max-height: var(--header-height);" />
                <div style="font-size: 32px; font-weight: bold;">PULCSI SHOP</div>
            </div>
            <partial name="_LoginPartial" />
        </header>

        <main>
            <div id="categories" style="display: flex; flex-direction: column; justify-content: center; height: calc(100vh - var(--footer-height) - var(--header-height));">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div class="content">
                @RenderBody()
                @RenderSection("scripts", required: false)
            </div>
        </main>

        <footer>
            &copy; 2025 - PulcsiShop -<a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

</body>
</html>